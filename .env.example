# ═══════════════════════════════════════════════════════════════
#  DENTOVERSE · NOVA AI — Environment Variables (all OPTIONAL)
#  Add these on Vercel → Project → Settings → Environment Variables.
#  Nova works WITHOUT any of these using its local PDF/site index.
#  Adding an LLM key improves grounded answer synthesis and natural
#  Arabic/English explanations. Phase 1 does not enable web search.
# ═══════════════════════════════════════════════════════════════

# ── LLM PROVIDER (set ONE) ──────────────────────────────────────
# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# OpenRouter (many models via one key)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Groq (fast, free tier)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# DeepSeek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# Mistral AI (La Plateforme — OpenAI-compatible)
# See https://docs.mistral.ai/models for the current model list.
# MISTRAL_API_KEY=...
# MISTRAL_MODEL=mistral-large-latest

# Alibaba Qwen (Qwen2.5 / Qwen-Omni) via DashScope OpenAI-compatible endpoint
# See https://qwen.ai — set QWEN_API_KEY (or DASHSCOPE_API_KEY).
# QWEN_API_KEY=sk-...
# QWEN_MODEL=qwen2.5-72b-instruct
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   # use mainland URL if needed

# Meta Llama 3.1 — no dedicated key needed; reach it through Groq or OpenRouter:
#   GROQ_API_KEY=...  + GROQ_MODEL=llama-3.1-70b-versatile
#   OPENROUTER_API_KEY=...  + OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct

# Google Gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash

# Generic OpenAI-compatible override (wins over the above)
# NOVA_LLM_BASE_URL=https://your-endpoint/v1
# NOVA_LLM_API_KEY=...
# NOVA_LLM_MODEL=your-model

# ═══════════════════════════════════════════════════════════════
#  NOVA · IMAGE DESIGN STUDIO — image generation backend (OPTIONAL)
#  Powers POST /api/nova-image. Without any of these, the Image
#  Studio still works fully as a premium prompt composer and simply
#  shows a "connect a model" placeholder instead of a generated image
#  (it NEVER fakes generation). Add ONE provider to enable real images.
# ═══════════════════════════════════════════════════════════════

# ── IMAGE PROVIDER (set ONE) ────────────────────────────────────
# OpenAI Images (DALL·E 3 / gpt-image-1). Reuses OPENAI_API_KEY above
# if already set for chat; override the image model here if needed.
# OPENAI_IMAGE_MODEL=gpt-image-1

# Stability AI (SD3 / SDXL)
# STABILITY_API_KEY=sk-...
# STABILITY_IMAGE_MODEL=sd3

# Generic OpenAI-compatible /images/generations endpoint (wins over the above)
# NOVA_IMAGE_BASE_URL=https://your-endpoint/v1
# NOVA_IMAGE_API_KEY=...
# NOVA_IMAGE_MODEL=your-image-model

