# ═══════════════════════════════════════════════════════════════
#  DENTOVERSE · NOVA AI — Environment Variables (all OPTIONAL)
#  Add these on Vercel → Project → Settings → Environment Variables.
#  Nova works WITHOUT any of these (offline local brain); adding an
#  LLM key unlocks true general-purpose multilingual answers, and a
#  search key unlocks live web grounding.
# ═══════════════════════════════════════════════════════════════

# ── LLM PROVIDER (set ONE) ──────────────────────────────────────
# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# OpenRouter (many models via one key)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Groq (fast, free tier)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# DeepSeek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# Google Gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash

# Generic OpenAI-compatible override (wins over the above)
# NOVA_LLM_BASE_URL=https://your-endpoint/v1
# NOVA_LLM_API_KEY=...
# NOVA_LLM_MODEL=your-model

# ── WEB SEARCH (optional; set ONE) ──────────────────────────────
# TAVILY_API_KEY=tvly-...
# SERPER_API_KEY=...
# BRAVE_API_KEY=...
# GOOGLE_CSE_KEY=...
# GOOGLE_CSE_CX=...
